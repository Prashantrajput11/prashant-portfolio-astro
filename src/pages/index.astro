    }

 .diagonal-highlight {
    position: relative;
    display: inline-block;
    padding: 0 4px;
    z-index: 1;
  }



  .diagonal-highlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, tomato 0%, transparent 100%);
    z-index: -1;
  }

  .resume-download {
  text-align: center;
  margin: 2rem 0;
}

.download-btn {




      background-color: rgba(72, 187, 120, 0.1);
            border: 0.6px solid #48BB78;
            padding: 0.6rem 1.2rem;
            border-radius: 4px;
            font-size: 0.8rem;
            color: white;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            font-weight: 500;
}

.download-btn:hover {
  background-color: rgba(72, 187, 120, 0.4);
}


.community-images {
  display: flex;
  flex-direction: row;
  gap: 1rem;
  flex-wrap: wrap;
}

