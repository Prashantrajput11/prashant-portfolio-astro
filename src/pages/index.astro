.project-list, .blog-list {
	width: 100%;
	overflow-x: hidden;
}


.work-left {
  display: flex;
  flex-direction: column;
}

.role {
  color: #48BB78;

  font-size: 0.85rem;
  margin-top: 2px;
}

.side-projects {
  margin-top: 2rem;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* ensures vertical spacing between items */
}


.project-item {
