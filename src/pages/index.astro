.skill-group {
  margin-bottom: 1.5rem;
}

.skill-group h3 {
  font-size: 0.8rem;
  margin-bottom: 0.5rem;
  color: #333;
}



			.social-links {
  text-align: center;
  margin-bottom: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.social-links a {
  color: 	 #48BB78;
  text-decoration: none;
  margin: 0 0.3rem;
}

.social-links a:hover {
  text-decoration: underline;
}

.social-links .dot {
  color: #888;
  margin: 0 0.4rem;
}


	.blog {
  margin-top: 2rem;
}



.blog-list {
  margin: 1rem 0;
