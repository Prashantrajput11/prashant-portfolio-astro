---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { getLatestPosts } from '../utils.js';
const latestPosts = await getLatestPosts(3); // fetch top 3



---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
		<section class="hero">
  <h1>
  Hey, I’m <span class="diagonal-highlight">Prashant</span> 👋
</h1>

  
I'm a full stack mobile app developer passionate about building products that solve real-world problems. I'm currently bringing that passion to life with Hiretales, a platform designed to help people share interview experiences and prepare for their careers. I enjoy crafting intuitive user interfaces in React Native and building the robust backend systems that power them.</section>

<section class="social-links">
  <a href="https://www.linkedin.com/in/prashantreactnative/" target="_blank" rel="noopener">LinkedIn</a>
  <span class="dot">•</span>
  <a href="https://x.com/theawesomedev_" target="_blank" rel="noopener">Twitter</a>
  <span class="dot">•</span>
  <a href="https://peerlist.io/theawesomedev" target="_blank" rel="noopener">Peerlist</a>
</section>

<section class="resume-download">
  <a class="download-btn" href="/prashant_full_stack.pdf" download>
    📄 Download My Resume
  </a>
</section>




			<section class="experience">
				<h2>My Professional Experience</h2>
				<div class="work-item">
  <div class="work-left">
    <strong>HireTales</strong>
    <div class="role">Founder, Building using React Native</div>
  </div>
  <div class="date">Jan 2025 – Present</div>
</div>

			<div class="work-item">
  <div class="work-left">
    <strong>The Confession Boxx</strong>
    <div class="role">React Native Engineer</div>
  </div>
  <div class="date">Jan 2024 – Present</div>
</div>
			<div class="work-item">
  <div class="work-left">
    	<strong>RocketMedia Technologies</strong>
    <div class="role">Software Developer</div>
  </div>
  <div class="date">Mar 2021 - Dec 2022</div>
</div>


			<div class="work-item">
  <div class="work-left">
    <strong>NIIT</strong>
    <div class="role">Associate Software Developer</div>
  </div>
  <div class="date">Aug 2020 - Mar 2021</div>
</div>

			
			
			</section>


			<section class="side-projects">
  <h2>Side Projects</h2>
 

	

	<div class="project-item">
  <a href="https://play.google.com/store/apps/details?id=com.superhappy&hl=en_IN" target="_blank" rel="noopener" class="project-link">
    <strong>Super Happy</strong> <span class="niche">| Mental health app</span> 
    <div class="tech">React Native, TanStack Query, Supabase</div>
  </a>
</div>
	<div class="project-item">
  <a href="https://github.com/Prashantrajput11/krishnaAI" target="_blank" rel="noopener" class="project-link">
    <strong>Krishna AI</strong> <span class="niche">| Devotional chat experience</span>
    <div class="tech">React Native, Zustand, OpenAI API</div>
  </a>
</div>
	<div class="project-item">
  <a href="https://github.com/Prashantrajput11/fullstackecom" target="_blank" rel="noopener" class="project-link">
    <strong>Ecomm App</strong> <span class="niche">| Full Stack Mobile Ecommerce App</span> 
    <div class="tech">React Native, Drizzle ORM, Express, Genezio</div>
  </a>
</div>

   
   
  </div>
</section>

<section class="beyond-work">
  <h2>Beyond Work</h2>
  <p>When I’m not building products, you’ll find me helping communities, mentoring younger developers . I believe in giving back and growing together.</p>
  
  <div class="community-images">
  <img src="/images/help1.png" alt="Community Help 1" />
  <img src="/images/help2.png" alt="Community Help 2" />
</div>

</section>

		

			<section class="blog">
  <h2>Latest Blog Posts</h2>
  <div class="blog-list">
    {latestPosts.map(post => (
      <div class="blog-preview">
       <a href={`/blog/${post.id}/`}>

          <strong>{post.data.title}</strong>
        </a>
        <div class="meta">{post.data.pubDate.toDateString()}</div>
      </div>
    ))}
  </div>
  <a href="/blog" class="view-all">View all posts →</a>
</section>

		<section class="skills">
  <h2>Skills</h2>
  <div class="skill-group">
    <h3>Frontend</h3>
    <div class="skill-tags">
      <span>JavaScript</span>
      <span>React</span>
      <span>React Native</span>
      <span>TypeScript</span>
      <span>Tailwind CSS</span>
      <span>Expo</span>
      <span>EAS</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Backend</h3>
    <div class="skill-tags">
      <span>Node.js</span>
      <span>Express.js</span>
      <span>Mongo DB</span>
      <span>Postgres SQL</span>
      <span>Firebase</span>
      <span>Supabase</span>
      <span>Genezio</span>
      <span>Drizzle ORM</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Databases</h3>
    <div class="skill-tags">
      <span>SQL</span>
      <span>PostgreSQL</span>
      <span>NeonDB</span>
      <span>Amazon DynamoDB</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Tools & DevOps</h3>
    <div class="skill-tags">
      <span>Git</span>
      <span>GitHub</span>
      <span>Xcode</span>
      <span>Android Studio</span>
      <span>Postman</span>
      <span>Insomnia</span>
      <span>Amazon CloudWatch</span>
    </div>
  </div>
</section>

		</main>
		<Footer />

		<style>
			main {
				max-width: 700px;
				margin: 0 auto;
				padding: 2rem;
				line-height: 1.6;
			}
			
			.hero {
				/* text-align: center; */
				margin-bottom: 3rem;
			}
			
			.hero h1 {  
				font-size: 2.2rem;
				margin-bottom: 0.5rem;
			}
			
			.hero p {
				color: #666;
				margin: 0.5rem 0;
			}
			
			h2 {
				font-size: 1.4rem;
				margin: 2rem 0 1rem 0;
			}

			.beyond-work {
  margin-top: 2.5rem;
}

.beyond-work p {
  color: #444;
  font-size: 0.95rem;
  margin-bottom: 1rem;
}

 .diagonal-highlight {
    position: relative;
    display: inline-block;
    padding: 0 4px;
    z-index: 1;
  }

  .diagonal-highlight::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, tomato 0%, transparent 100%);
    z-index: -1;
  }

  .resume-download {
  text-align: center;
  margin: 2rem 0;
}

.download-btn {
  background-color: tomato;
  color: white;
  padding: 0.6rem 1.2rem;
  border-radius: 30px;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: bold;
  display: inline-block;
  transition: background-color 0.2s ease;
}

.download-btn:hover {
  background-color: #d83c1c;
}


.community-images {
  display: flex;
  flex-direction: row;
  gap: 1rem;
  flex-wrap: wrap;
}

.community-images img {
  max-width: 100%;
  width: 48%;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.skill-group {
  margin-bottom: 1.5rem;
}

.skill-group h3 {
  font-size: 0.8rem;
  margin-bottom: 0.5rem;
  color: #333;
}



			.social-links {
  text-align: center;
  margin-bottom: 2rem;
  font-size: 0.9rem;
  color: #666;
}

.social-links a {
  color: tomato;
  text-decoration: none;
  margin: 0 0.3rem;
}

.social-links a:hover {
  text-decoration: underline;
}

.social-links .dot {
  color: #888;
  margin: 0 0.4rem;
}


	.blog {
  margin-top: 2rem;
}



.blog-list {
  margin: 1rem 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.blog-preview {
  font-size: 0.9rem;
  line-height: 1.4;
}

.blog-preview a {
  text-decoration: none;
  color: tomato;
}

.blog-preview a:hover {
  text-decoration: underline;
}

.meta {
  color: #777;
  font-size: 0.8rem;
  margin-top: 0.2rem;
}

.view-all {
  color: tomato;
  font-size: 0.9rem;
  text-decoration: none;
  display: inline-block;
  margin-top: 0.5rem;
}

.view-all:hover {
  text-decoration: underline;
}

			
			/* .work-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.8rem;
  padding: 0.8rem;
  background: #f8f9fa;
  border-radius: 6px;
  font-size: 0.9rem;
} */

.work-item {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	align-items: flex-start;
	word-break: break-word;
	width: 100%;
	margin-bottom: 1.5rem; /* ADD THIS */
	
}

.project-list, .blog-list {
	width: 100%;
	overflow-x: hidden;
}


.work-left {
  display: flex;
  flex-direction: column;
}

.role {
  color: #444;
  font-size: 0.85rem;
  margin-top: 2px;
}

.side-projects {
  margin-top: 2rem;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 1rem; /* ensures vertical spacing between items */
}


.project-item {
  /* background: #f8f9fa; REMOVE THIS */
  padding: 0.8rem 0;
  border-bottom: 1px dotted tomato ; /* ADD THIS */
  font-size: 0.9rem;
}


.project-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.project-link:hover {
  background: #eef1f4;
  text-decoration: none;
}

.arrow {
  font-size: 0.85rem;
  margin-left: 0.3rem;
  color: tomato;
}


.niche {
  color: #555;
  font-weight: normal;
  margin-left: 0.3rem;
}

.tech {
  font-size: 0.85rem;
  color: #666;
  margin-top: 0.2rem;
}


			
			.date {
				color: #666;
				font-size: 0.9rem;
			}
			
			.blog-list {
				margin: 1rem 0;
			}
			
			/* .view-all {
				color: #007acc;
				text-decoration: none;
			} */
			
			.skill-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
        color : white
			}
			
			.skill-tags span {
				/* background: #e3f2fd; */
				background: tomato;
				padding: 0.4rem 0.8rem;
				border-radius: 20px;
				font-size: 0.8rem;
        color "#fff"
			}
			
			@media (max-width: 768px) {
				.work-item {
					flex-direction: column;
				
				}
				.date {
					margin-top: 0.3rem;
				}
			}
		</style>
	</body>
</html>