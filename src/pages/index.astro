  flex-direction: column;
  gap: 1rem;
}

.blog-preview {
  font-size: 0.9rem;
  line-height: 1.4;
}

.blog-preview a {
  text-decoration: none;
  color: tomato;
}

.blog-preview a:hover {
  text-decoration: underline;
}

.meta {
  color: #777;
  font-size: 0.8rem;
  margin-top: 0.2rem;
}

.view-all {
  color: #48BB78;
  font-size: 0.9rem;
  text-decoration: none;
  display: inline-block;
  margin-top: 0.5rem;
}

.view-all:hover {
  text-decoration: underline;
}

			
